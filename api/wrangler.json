{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-labs-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cv-labs",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TEACHERS": "Sosekie",
    "ALLOWED_ORIGINS": "https://sosekie.github.io",
    "SITE_PATH": "/Unibe-CVG-CV-Interactive-Labs/"
  }
}
